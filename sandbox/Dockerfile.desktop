# ── Sandbox — graphical desktop variant ──────────────────────────────────────
# Stage 2 of the browser-Linux workbench: the real Pwnbox/Hackviser-style
# experience — a full XFCE desktop reached through the browser via noVNC.
# See docs/superpowers/specs/2026-09-01-browser-linux-pwnbox-design.md for
# the full engineering assessment and why this is a SEPARATE, opt-in image
# rather than added to the default headless sandbox: it relaxes properties
# the headless variant's security docs state as read (writable home for
# desktop-session state, a persistent process tree instead of one-shot
# `docker exec`s). The network trust boundary is untouched either way — this
# container's default route still goes through gateway, same as headless.
#
# This is also where the operator's original separate-RE-sandbox idea lives:
# GUI reverse-engineering tooling needs a desktop, which the headless
# variant structurally cannot provide.

FROM golang:1.26.6-bookworm AS mcpbuilder
WORKDIR /build
COPY sandbox-mcp/go.mod sandbox-mcp/go.sum ./
RUN go mod download
COPY sandbox-mcp/*.go ./
RUN CGO_ENABLED=0 go build -trimpath -o /out/yummi-sandbox-mcp .

FROM kalilinux/kali-rolling:latest

LABEL org.opencontainers.image.title="Yummi sandbox (desktop)"
LABEL org.opencontainers.image.description="Isolated Kali pentest container with a full XFCE desktop, reached via noVNC — network traffic gated by gateway"
LABEL org.opencontainers.image.licenses="Apache-2.0"
LABEL org.opencontainers.image.source="https://github.com/n0connect/yummi"

ENV DEBIAN_FRONTEND=noninteractive

# Same pentest tool set as the headless sandbox (kept in sync by hand — see
# sandbox/Dockerfile's own list) plus the desktop stack: xfce4 (window
# manager + panel + session), a terminal and file manager, tigervnc (the VNC
# server), novnc + websockify (browser-reachable VNC over a WebSocket),
# dbus-x11 (XFCE needs a session bus), and firefox-esr for in-browser
# recon/testing work from inside the sandbox itself.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      amass \
      ca-certificates \
      crunch \
      curl \
      dirb \
      dnsenum \
      enum4linux \
      ffuf \
      git \
      gobuster \
      hydra \
      iptables \
      iproute2 \
      jq \
      libcap2-bin \
      medusa \
      netcat-openbsd \
      nftables \
      nikto \
      nmap \
      nuclei \
      onesixtyone \
      smbclient \
      snmp \
      socat \
      sqlmap \
      subfinder \
      tcpdump \
      theharvester \
      tmux \
      wafw00f \
      wget \
      whatweb \
      wpscan \
      ripgrep \
      xfce4 \
      xfce4-terminal \
      thunar \
      dbus-x11 \
      tigervnc-standalone-server \
      tigervnc-common \
      novnc \
      websockify \
      firefox-esr \
      wireshark \
      x11-xserver-utils && \
    if [ -f /usr/lib/nmap/nmap ]; then setcap cap_net_admin,cap_net_raw=eip /usr/lib/nmap/nmap; fi && \
    for tool in nmap curl ffuf gobuster nikto whatweb grep rg git tmux Xtigervnc websockify xfce4-session; do command -v "$tool" >/dev/null; done && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1000 pentester && \
    useradd --uid 1000 --gid pentester --create-home --shell /bin/bash pentester && \
    # wireshark's dumpcap needs this group to capture without full root —
    # matches nmap's setcap-based (not root-based) capability grant above.
    # Best-effort: the "wireshark" group only exists if the wireshark-common
    # package's debconf prompt (non-interactive here) created it, which isn't
    # guaranteed across Kali rolling snapshots — dumpcap still works as root
    # via `sudo`-less docker exec's own privilege if this doesn't apply, so
    # this must not fail the whole image build over it.
    (usermod -aG wireshark pentester || true)

COPY sandbox/entrypoint-desktop.sh /usr/local/bin/entrypoint.sh
RUN chmod 0755 /usr/local/bin/entrypoint.sh

COPY --from=mcpbuilder /out/yummi-sandbox-mcp /usr/local/bin/yummi-sandbox-mcp
RUN chmod 0755 /usr/local/bin/yummi-sandbox-mcp

WORKDIR /home/pentester

# 6080: websockify's WebSocket<->VNC bridge, proxied by orchestrator's
# /ws/desktop handler — never published to the host directly, same pattern
# as the headless sandbox never publishing a port of its own.
EXPOSE 6080

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=90s \
    CMD curl -sf http://127.0.0.1:6080/ > /dev/null 2>&1

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
