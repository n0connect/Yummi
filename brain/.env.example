# Copy to .env and fill in. Never commit the real .env.

# Where the Yummi orchestrator's REST API is reachable (make start's default).
YUMMI_ORCHESTRATOR_URL=http://127.0.0.1:9080

# Any OpenAI-compatible endpoint. OpenRouter shown here; api.openai.com or
# a self-hosted OpenAI-compatible server (vLLM, LM Studio, ...) work too.
YUMMI_BRAIN_MODEL_BASE_URL=https://openrouter.ai/api/v1
YUMMI_BRAIN_MODEL_NAME=anthropic/claude-3.5-sonnet
YUMMI_BRAIN_MODEL_API_KEY=sk-or-v1-your-key-here

# Session id used for every REST call and MCP tool call this run makes —
# findings/executions/audit all key off this. Give each real engagement its
# own value.
YUMMI_BRAIN_SESSION_ID=brain-default

# Where LangGraph's checkpointer persists graph state. Separate from the
# orchestrator's own sessions.db by design.
YUMMI_BRAIN_CHECKPOINT_DB=yummi_brain_checkpoints.sqlite
