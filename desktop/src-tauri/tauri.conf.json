{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yummi",
  "version": "0.1.0",
  "identifier": "com.n0connect.yummi",
  "build": {
    "beforeDevCommand": "cd ../ui && npm run dev -- --host 127.0.0.1 --port 1420",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "cd ../ui && npm run build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Yummi",
        "width": 1100,
        "height": 700,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:9080 ws://127.0.0.1:9080; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "shortDescription": "Privacy-first AI pentest conductor"
  }
}
