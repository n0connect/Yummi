# Docker build context excludes (repo root is the context for gateway,
# sandbox, and orchestrator builds — `context: .` in docker-compose.yml).
#
# Without this file, every `docker build` uploads the ENTIRE repo tree to the
# daemon before the first RUN — including the ~1.8GB `thirdy-party/` research
# folder, the `.git` history, and `.yummi.conf` (which can hold a live API
# key). This file keeps the context to just what the Dockerfiles actually
# COPY. It must never exclude a path a Dockerfile depends on: the KEEP list at
# the bottom documents exactly those.
#
# ui/ builds from its own separate context (./ui) with its own ui/.dockerignore,
# so excluding ui/ here only trims it out of the gateway/sandbox/orchestrator
# contexts, which never need it.

# ── Secrets / local config (must never enter a build context) ───────────────
.yummi.conf
*.env
.env
.env.*
!*.env.example
**/*.pem
**/*.key
**/id_rsa*

# ── Version control & CI (not needed to build anything) ─────────────────────
.git
.gitignore
.gitattributes
.github

# ── Huge local-only trees (research/competitor checkouts, never shipped) ────
thirdy-party/

# ── Build artifacts & dependency caches (images rebuild these from source) ──
bin/
**/node_modules
gateway/target
ui/dist
ui/node_modules
**/*.db
**/*.db-shm
**/*.db-wal
**/*.sqlite
**/*.log

# ── Editor / OS cruft ───────────────────────────────────────────────────────
.DS_Store
.vscode
.idea
*.swp

# ── Repo tooling & docs not consumed by any Dockerfile ──────────────────────
brain/
docs/
scripts/
Makefile
docker-compose*.yml
*.md
LICENSE
CHANGELOG.md
.yummi.conf.example

# ── KEEP (do NOT add these to the excludes above) ───────────────────────────
#   gateway/          — gateway/Dockerfile: Cargo.{toml,lock}, src/, config/
#   sandbox/          — sandbox/Dockerfile: entrypoint.sh
#   sandbox-mcp/      — sandbox/Dockerfile: go.mod/go.sum/*.go (MCP server build stage)
#   orchestrator/     — orchestrator/Dockerfile: the whole module
#   persona/          — orchestrator/Dockerfile: COPY persona /persona
