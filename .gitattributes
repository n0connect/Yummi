# Set default behavior to automatically normalize line endings
* text=auto

# Ensure shell scripts, Makefiles, Dockerfiles and source files keep LF line endings across all platforms (Linux, macOS, Windows WSL2)
*.sh text eol=lf
*.bash text eol=lf
*.go text eol=lf
*.rs text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
Makefile text eol=lf
Dockerfile* text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.tar.gz binary
*.zip binary
*.db binary
*.sqlite binary
