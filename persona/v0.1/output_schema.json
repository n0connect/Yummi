{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["intent", "message"],
  "properties": {
    "intent": {
      "enum": ["suggest_command", "ask_clarification", "explain", "decline"],
      "description": "suggest_command=has proposals, ask_clarification=need more info, explain=informational, decline=refused"
    },
    "message": {
      "type": "string",
      "description": "Human-readable response in user's language"
    },
    "proposals": {
      "type": "array",
      "description": "Commands to execute. Required when intent=suggest_command",
      "items": {
        "type": "object",
        "required": ["id", "command", "risk_level"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique ID like p1, p2"
          },
          "command": {
            "type": "string",
            "description": "Exact command to execute"
          },
          "rationale": {
            "type": "string",
            "description": "Why this command"
          },
          "risk_level": {
            "enum": ["low", "medium", "high", "critical"]
          },
          "requires_approval": {
            "type": "boolean",
            "default": false
          },
          "target_tool": {
            "type": "string",
            "description": "Tool name (nmap, ffuf, etc.)"
          }
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "0-1 confidence score"
    }
  }
}
